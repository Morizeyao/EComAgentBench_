# ===== EComAgentBench API keys =====
# Copy this file to `.env` and fill in your own keys.
# The open-source version uses each vendor's OFFICIAL API; no custom base_url is needed.
# Keys are read per-vendor (see src/llm/utils.py:resolve_api_key).

# OpenAI (GPT family) -- https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Anthropic (Claude family) -- https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key

# Google Gemini -- https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# OpenRouter (Kimi / MiniMax / Qwen / etc.) -- https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
# Optional: override the OpenRouter endpoint (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: HuggingFace token for scripts/download_amazon_reviews.py (raises download rate limit)
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
